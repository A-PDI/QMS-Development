# Microsoft Entra ID app registration credentials
# Get these from portal.azure.com → Microsoft Entra ID → App registrations → your app
# These are NOT secrets — they are safe to commit once your app registration is live.

VITE_ENTRA_TENANT_ID=your-tenant-id-here
VITE_ENTRA_CLIENT_ID=your-client-id-here

# The time zone injector test times are shown in (IANA name). Defaults to
# America/Denver — Mountain Time. Keep it the same as the server's
# INJECTOR_TIME_ZONE so the screen, the filters and the reports agree.
VITE_INJECTOR_TIME_ZONE=America/Denver
