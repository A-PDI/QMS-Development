# ─────────────────────────────────────────────────────────────────────────────
# PDI Inspection App — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in the values before deploying.
# NEVER commit the actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Node environment — must be "production"
NODE_ENV=production

# Port the Express server listens on.
# If running behind IIS with URL Rewrite, this can remain 3001.
PORT=3001

# The public URL where the app is accessed by users.
# Must exactly match a Redirect URI registered in your Azure app registration.
# Example: https://inspection.yourcompany.com
CLIENT_URL=https://inspection.yourcompany.com

# ── Authentication: Microsoft Entra ID ───────────────────────────────────────
# From portal.azure.com → Entra ID → App registrations → your app → Overview
ENTRA_TENANT_ID=your-directory-tenant-id
ENTRA_CLIENT_ID=your-application-client-id

# ── JWT (internal app tokens) ─────────────────────────────────────────────────
# Generate a strong random secret — e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
# Keep this secret. Changing it will invalidate all active sessions.
JWT_SECRET=replace-with-a-long-random-string-at-least-48-characters

# ── Database ──────────────────────────────────────────────────────────────────
DB_ADAPTER=sqlite

# Use an absolute path so the database location doesn't depend on the working
# directory. Create this directory before first run.
# Example: C:\PDIApp\data\inspection.db
SQLITE_PATH=C:\PDIApp\data\inspection.db

# ── File uploads ──────────────────────────────────────────────────────────────
# Absolute path to the uploads folder. Must be writable by the process account.
UPLOAD_DIR=C:\PDIApp\uploads
MAX_FILE_SIZE_MB=25

# ── E-sign ───────────────────────────────────────────────────────────────────
# Signers open <ESIGN_PUBLIC_URL>/sign/<token>. Defaults to CLIENT_URL.
ESIGN_PUBLIC_URL=https://inspection.yourcompany.com
# Field detector (esign-detector/, run by PM2 as pdi-esign-detector). When it is
# down, uploads still work and fields are placed by hand.
ESIGN_DETECTOR_URL=http://127.0.0.1:8765
ESIGN_DETECTOR_ENABLED=true
ESIGN_DETECTOR_TIMEOUT_MS=120000
# Only needed if DETECTOR_API_KEY is set for the detector process; must match it.
ESIGN_DETECTOR_API_KEY=
ESIGN_EXPIRY_DAYS=30
ESIGN_DOWNLOAD_DAYS=30
ESIGN_MAX_PDF_MB=25
ESIGN_MAX_PAGES=50
ESIGN_MAX_ATTACH_MB=10
# Dates stamped on documents and the certificate. Defaults to INJECTOR_TIME_ZONE.
ESIGN_TIME_ZONE=America/Denver
# Certificate that seals completed PDFs (tamper-evident). Create one with:
#   set ESIGN_P12_PASSPHRASE=...   (12+ characters)
#   node scripts/esign-generate-cert.js C:\PDIApp\esign-seal.p12
# Leave ESIGN_P12_PATH empty to finish documents without a seal.
ESIGN_P12_PATH=C:\PDIApp\esign-seal.p12
ESIGN_P12_PASSPHRASE=
ESIGN_SEAL_NAME=Performance Diesel Inc.
ESIGN_SEAL_LOCATION=St. George, UT
ESIGN_SEAL_CONTACT=

# ── E-sign mail (SMTP) ───────────────────────────────────────────────────────
# With SMTP_HOST empty, e-mails are only written to the log and signing links
# are shown on the envelope page instead (only outside production).
# ESIGN_MAIL_TRANSPORT=json forces that even when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PDI Documents <documents@example.com>"
ESIGN_MAIL_TRANSPORT=
