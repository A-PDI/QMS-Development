NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_random_64_char_string
AUTH_MODE=local
DB_ADAPTER=sqlite
SQLITE_PATH=./data/inspection.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
ADMIN_PASSWORD=changeme

# ── Injector tests: the shop's clock ─────────────────────────────────────────
# Test timestamps are stored in UTC and shown, filtered and grouped in this IANA
# zone. Keep it the same as the client's VITE_INJECTOR_TIME_ZONE.
# America/Denver is Mountain Time (MST/MDT); use America/Phoenix for a shop that
# does not observe daylight saving.
INJECTOR_TIME_ZONE=America/Denver

# ── Daily export of passed injectors to a Google Sheet ───────────────────────
# Each day the server appends one row per injector that passed the day before:
# Test Date, Part Number, Serial Number.
#
# Setup: Google Cloud console → new project → enable the Google Sheets API →
# create a service account → download its JSON key → share the spreadsheet with
# the service account's email address (Editor). The export stays off until the
# spreadsheet id and the credentials below are both set.
GOOGLE_SHEETS_SPREADSHEET_ID=
# The sheet tab and columns to append to, in A1 notation. A tab name containing
# a space must be wrapped in single quotes, as A1 notation requires:
#   GOOGLE_SHEETS_RANGE='Passed Injectors'!A:C
GOOGLE_SHEETS_RANGE=Sheet1!A:C
# Either point at the downloaded JSON key file…
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# …or paste the two values out of it (keep the \n escapes in the private key,
# and wrap it in quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# When the export runs, on the shop's clock. Default 00:05, covering the day
# that just ended. Set INJECTOR_SHEET_EXPORT_ENABLED=false to stop scheduling it
# without removing the credentials.
INJECTOR_SHEET_EXPORT_AT=00:05
INJECTOR_SHEET_EXPORT_ENABLED=true
