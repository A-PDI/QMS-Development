NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_random_64_char_string
AUTH_MODE=local
DB_ADAPTER=sqlite
SQLITE_PATH=./data/inspection.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
ADMIN_PASSWORD=changeme

# ── Injector tests: the shop's clock ─────────────────────────────────────────
# Test timestamps are stored in UTC and shown, filtered and grouped in this IANA
# zone. Keep it the same as the client's VITE_INJECTOR_TIME_ZONE.
# America/Denver is Mountain Time (MST/MDT); use America/Phoenix for a shop that
# does not observe daylight saving.
INJECTOR_TIME_ZONE=America/Denver

# ── Daily export of passed injectors to a Google Sheet ───────────────────────
# Each day the server appends one row per injector that passed the day before:
# Test Date, Part Number, Serial Number.
#
# Setup: Google Cloud console → new project → enable the Google Sheets API →
# create a service account → download its JSON key → share the spreadsheet with
# the service account's email address (Editor). The export stays off until the
# spreadsheet id and the credentials below are both set.
GOOGLE_SHEETS_SPREADSHEET_ID=1JU8tCPdL1ArrEB4tCwT0xUKjKpWUA_PqRnnGoqf7gmk
# The sheet tab and columns to append to, in A1 notation. A tab name containing
# a space must be wrapped in single quotes, as A1 notation requires:
#   GOOGLE_SHEETS_RANGE='Passed Injectors'!A:C
GOOGLE_SHEETS_RANGE=Sheet1!A:C
# Either point at the downloaded JSON key file…
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# …or paste the two values out of it (keep the \n escapes in the private key,
# and wrap it in quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=pdi-injector-export@pdi-sqms.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCbxiMUUEIHmDZa\nQcmVe+92uUTTZaJ8hcaPHm0h2ON+7E1er7ooC1Ki/iipko+zLWnwimHQCivmmOUs\nmaIHFMjOe9lCHoZQHiUHupcVr/0RIQi5LNKaZCJLKINStiWj5Al/LUy4c/tzx6JT\nJ2Lc+NFVVs2EojIFkAxLdUksH76/GV4hcy350B8HCNkihvj5XzViz127FA9UFq4E\n2q/+9wPS4HliaqKRKYTAWv0iIZH7LgGwNW5pWB5q6+BVP/YOwpS/nxvmeVGIWvwa\ndIaMrZaChnJZ9Y4YQV6tc2Dl5g2j3ZoXWoBobc7OusODDDJSkxiLuuc7zH+ugSMO\nDhLcvBE3AgMBAAECggEAFc88PW2DNnxULSIwLr1caJtF4fHFOc6iXzVbrYp9R4RJ\nd4FTp072h0WIZz19ixDyV9riw6A48fSO2Ztk+RLVjpCpJBMRVl7yFk6Z3/p04b9l\n8O8v9AJ4XrInDh8xzpbF0Z2DtADhFXO/lrQuqPuD64EsuG4xDLWp/a1HzRALbRvQ\nixjGRcVbdAWt4ZHfitSbMmUlyYSnhmVk8YYXUPQjbnvCPh36Jl+0lDN8y2tk2/Fb\n2Wyg4HBTNaeRGXLT3fiokAgaqNsmTlzoGQXIuewHNOd70dVQISj3Nm8aO9Hf8sjL\nZSkCHjbFEu8jPf/I9jHK8tzsN/ylJ49x/f0qt1+IiQKBgQDJ3mKlE12c2Vh6xj9H\nah8f3E1cWQYWNLk4aFkLRr8xtpcHDpyqfs3H/RTSJxpr3UareyIMR+qMBqzrT0Iv\nUHW19Zy2SxYcC4p6SuRj5RDgdPKxNxqGlyLcOnlE34KO2Ky5DcrPGI1fx1RcQu4d\nyGwlc2u0grr+MAhwdBpeQ58dSwKBgQDFi4Cd6+XqLbtTnxHmRU1dGQ5pPriUZw0p\n1AkXrzi7DqEWdz/4RDqQ0rXOAu/aoQIngkxuICq5Z84EFsLckRG3iIdBZOBhwnl7\n2ft2wzGBxUKQbsbZdNTOaMtGXEx02i4q8gVpvhy8ZOx+mU2o8I+UVoU4JbbdToqV\nrPmqaKwERQKBgQDDevVdU0Z4h8P1iBpo5mvjZ2sGfTK2uDGQXQO1NroYwu63J8Aw\nHgDZo8rQwosEXs97aQ6Mg+ut0x0J9MNrm+eQ35n0sPtlBwv+5p0J2x0frkABuhGW\nua5JQtqCBkqgV1PTE3cMWoM0d4rKmQmKj7WiAoYO0/WOBid19gg+tg7TxwKBgH21\nlaZpXMkWSxQesPxRc7bf4AzXbgx6O6U3moWo6rgWyioKvvmVKZPJkwpDUjFVrpJH\n161o6OdNiIuPlHdaFeUui6vwrt1nLXnEMMLV2iZTylUxOXdeYqHrjBf9WmYuBZ0s\noIc3BQBaVSkHE6WDWEs0d9hQH7tbZNN03Pg1XenlAoGAGfCzCM/RSCFb+PfEi97A\n3T8NKiu097rjEULz1JYz2j4wMDpbUXK2ZQMjUhNkaSeZM6WVv2K+gF1SBXL5Ip1S\nAs781PEHLd0hib31J+JodngBB0JgcJMS4+1Obw3NWVM8ahnfcdMuv1Sqt+8986h6\n/J5aCLCcovX+EdWi8fF6WFc=\n-----END PRIVATE KEY-----\n"
# When the export runs, on the shop's clock. Default 00:05, covering the day
# that just ended. Set INJECTOR_SHEET_EXPORT_ENABLED=false to stop scheduling it
# without removing the credentials.
INJECTOR_SHEET_EXPORT_AT=00:05
INJECTOR_SHEET_EXPORT_ENABLED=true
