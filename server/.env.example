# TEMPLATE — committed to the repository and never read by the server.
#
# Real values belong in server/.env, which is listed in .gitignore and exists
# only on the machine that runs the app. Copy this file to server/.env there
# and fill it in; nothing you type HERE has any effect, and a secret typed here
# is published to everyone with access to the repository and stays in its
# history.
#
#   cp server/.env.example server/.env     (Windows: copy server\.env.example server\.env)

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_random_64_char_string
AUTH_MODE=local
DB_ADAPTER=sqlite
SQLITE_PATH=./data/inspection.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
ADMIN_PASSWORD=changeme

# ── Injector tests: the shop's clock ─────────────────────────────────────────
# Test timestamps are stored in UTC and shown, filtered and grouped in this IANA
# zone. Keep it the same as the client's VITE_INJECTOR_TIME_ZONE.
# America/Denver is Mountain Time (MST/MDT); use America/Phoenix for a shop that
# does not observe daylight saving.
INJECTOR_TIME_ZONE=America/Denver

# ── Daily export of passed injectors to a Google Sheet ───────────────────────
# Each day the server appends one row per injector that passed the day before:
# Test Date, Part Number, Serial Number.
#
# Setup: Google Cloud console → new project → enable the Google Sheets API →
# create a service account → download its JSON key → share the spreadsheet with
# the service account's email address (Editor). The export stays off until the
# spreadsheet id and the credentials below are both set.
#
# These stay EMPTY here. Fill them in server/.env on the server.
GOOGLE_SHEETS_SPREADSHEET_ID=
# The sheet tab and columns to append to, in A1 notation. A tab name containing
# a space must be wrapped in single quotes, as A1 notation requires:
#   GOOGLE_SHEETS_RANGE='Passed Injectors'!A:C
GOOGLE_SHEETS_RANGE=Sheet1!A:C
# Either point at the downloaded JSON key file…
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# …or paste the two values out of it (keep the \n escapes in the private key,
# and wrap it in quotes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# When the export runs, on the shop's clock. Default 00:05, covering the day
# that just ended. Set INJECTOR_SHEET_EXPORT_ENABLED=false to stop scheduling it
# without removing the credentials.
INJECTOR_SHEET_EXPORT_AT=00:05
INJECTOR_SHEET_EXPORT_ENABLED=true

# ── E-sign ───────────────────────────────────────────────────────────────────
# Signers open <ESIGN_PUBLIC_URL>/sign/<token>. Defaults to CLIENT_URL.
ESIGN_PUBLIC_URL=
# Field detector (esign-detector/, run by PM2 as pdi-esign-detector). When it is
# down, uploads still work and fields are placed by hand.
ESIGN_DETECTOR_URL=http://127.0.0.1:8765
ESIGN_DETECTOR_ENABLED=true
ESIGN_DETECTOR_TIMEOUT_MS=120000
# Only needed if DETECTOR_API_KEY is set for the detector process; must match it.
ESIGN_DETECTOR_API_KEY=
ESIGN_EXPIRY_DAYS=30
ESIGN_DOWNLOAD_DAYS=30
ESIGN_MAX_PDF_MB=25
ESIGN_MAX_PAGES=50
ESIGN_MAX_ATTACH_MB=10
# Dates stamped on documents and the certificate. Defaults to INJECTOR_TIME_ZONE.
ESIGN_TIME_ZONE=America/Denver
# Certificate that seals completed PDFs (tamper-evident). Create one with:
#   set ESIGN_P12_PASSPHRASE=...   (12+ characters)
#   node scripts/esign-generate-cert.js C:\PDIApp\esign-seal.p12
# Leave ESIGN_P12_PATH empty to finish documents without a seal.
ESIGN_P12_PATH=
ESIGN_P12_PASSPHRASE=
ESIGN_SEAL_NAME=Performance Diesel Inc.
ESIGN_SEAL_LOCATION=St. George, UT
ESIGN_SEAL_CONTACT=

# ── E-sign mail (SMTP) ───────────────────────────────────────────────────────
# With SMTP_HOST empty, e-mails are only written to the log and signing links
# are shown on the envelope page instead (development only).
# ESIGN_MAIL_TRANSPORT=json forces that even when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PDI Documents <documents@example.com>"
ESIGN_MAIL_TRANSPORT=
